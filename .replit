entrypoint = "main.sh"
modules = ["nodejs-20", "web", "python-3.12", "nix"]

[nix]
channel = "stable-25_05"

[deployment]
run = ["bash", "main.sh"]
deploymentTarget = "cloudrun"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
VITE_FIREBASE_APP_ID = "1:93403045274:web:287726d2fa08ffc9efae23"
VITE_FIREBASE_AUTH_DOMAIN = "gimnasio-70f9b.firebaseapp.com"
VITE_FIREBASE_MEASUREMENT_ID = "G-5QRZD51X7R"
VITE_FIREBASE_MESSAGING_SENDER_ID = "93403045274"
VITE_FIREBASE_PROJECT_ID = "gimnasio-70f9b"
VITE_FIREBASE_STORAGE_BUCKET = "gimnasio-70f9b.firebasestorage.app"
